# Settlement Radio — the shape of .env (§23). Committed, always current, values always empty.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and never leaves the machine. Adding a key here and to config.py happens in
# the same commit, or a fresh clone starts and then fails at 02:00 instead of at startup.

# --- required: every command stops at startup until these are set ---

# postgresql://user:password@host:5432/station
DATABASE_URL=

# the external volume (§4): pgdata, segments, archive, music, pool, imaging, logs
MEDIA_ROOT=

# --- optional: the command that needs one fails naming it ---

# Icecast source password (§23). Also lives on the Transmitter in /etc/settlement/env.
ICECAST_SOURCE_PASSWORD=

# DEBUG | INFO | WARNING | ERROR  (§24; DEBUG logs full prompts, so never on the Studio at night)
LOG_LEVEL=

# --- tuning: defaults live in config.py; set one here only to override it ---
# Nested settings use a double underscore.

# TTS__TARGET_LUFS=
# TTS__PER_TURN_TIMEOUT_S=
# BATCH__START_HOUR=
# BATCH__MUST_FINISH_BY=
